# EvidenceGraph AI Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Security
SECRET_KEY=evidencegraph_ai_super_secret_jwt_key_replace_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
# Use SQLite for easy local development or PostgreSQL for production
DATABASE_URL=sqlite:///./evidencegraph.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evidencegraph_db

# Qdrant Vector DB
# Local disk-persisted storage or Qdrant Server URL
QDRANT_MODE=local
QDRANT_PATH=./qdrant_storage
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Embeddings
EMBEDDING_PROVIDER=fastembed  # Options: fastembed, sentence-transformers, gemini
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Document Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
